# ==================================================
# BIRTHDAY SALE CAMPAIGN ENVIRONMENT CONFIGURATION
# ==================================================

# --------------------------------------------------
# 1. PERSISTENT STORAGE (REQUIRED FOR VERCEL DEPLOYMENT)
# In Vercel serverless environments, local JSON files in data/
# cannot persist across lambdas and cold starts.
# Choose ONE of the following options:
# --------------------------------------------------

# OPTION A (Recommended for Vercel): Vercel KV / Upstash Redis
# Add via Vercel Dashboard -> Storage -> KV (or Upstash Redis)
# Uses stateless HTTPS REST (zero connection pool limits)
KV_REST_API_URL=https://your-upstash-redis-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
# (or UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN)

# OPTION B: MongoDB Atlas
# Connection string to MongoDB cluster
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority
# MONGODB_DB_NAME=developer_portfolio

# --------------------------------------------------
# 2. EMAIL NOTIFICATIONS (REQUIRED TO DELIVER TO dipeshjangir12@gmail.com)
# Choose ONE of the following options:
# --------------------------------------------------

# OPTION A (Recommended for Vercel): Resend API
# Create a free API key at https://resend.com
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=Birthday Sale <onboarding@resend.dev>

# OPTION B: SMTP (e.g. Gmail App Password)
# Under Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dipeshjangir12@gmail.com
SMTP_PASS=your_google_app_password

# --------------------------------------------------
# 3. LOCAL DEV SERVER SETTINGS (Optional)
# --------------------------------------------------
PORT=5000
